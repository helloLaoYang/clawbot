HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/clawbot.sqlite
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5-mini
ADMIN_TOKEN=replace-with-a-long-random-token
# Optional; defaults to ADMIN_TOKEN when omitted.
WEBHOOK_TOKEN=replace-with-a-different-long-random-token
# Exactly 32 random bytes encoded as base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
CONTEXT_WINDOW_TOKENS=32000
CONTEXT_COMPACT_RATIO=0.7
CONTEXT_KEEP_MESSAGES=20
CONTEXT_SUMMARY_MAX_TOKENS=1500
CONTEXT_IMAGE_TOKENS=2000
MAX_CONCURRENT_USERS=4
